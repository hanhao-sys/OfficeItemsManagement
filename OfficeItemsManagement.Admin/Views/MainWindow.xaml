<Window x:Class="OfficeItemsManagement.Admin.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="办公物品管理系统 - 管理员" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部导航 -->
        <Border Grid.Row="0" Background="#0078D4" Padding="10">
            <Grid>
                <TextBlock Text="办公物品管理系统（管理员端）" FontSize="20" FontWeight="Bold"
                           Foreground="White" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="用户维护" Tag="User" Click="NavButton_Click"
                            Background="#005A9E" Foreground="White" Margin="2" Width="100"/>
                    <Button Content="物品信息" Tag="Item" Click="NavButton_Click"
                            Background="#005A9E" Foreground="White" Margin="2" Width="100"/>
                    <Button Content="物品入库" Tag="StockIn" Click="NavButton_Click"
                            Background="#005A9E" Foreground="White" Margin="2" Width="100"/>
                    <Button Content="物品出库" Tag="StockOut" Click="NavButton_Click"
                            Background="#005A9E" Foreground="White" Margin="2" Width="100"/>
                    <Button Content="库存查询" Tag="StockQuery" Click="NavButton_Click"
                            Background="#005A9E" Foreground="White" Margin="2" Width="100"/>
                    <Button Content="退出" Click="BtnLogout_Click"
                            Background="#D83B01" Foreground="White" Margin="8,2,2,2" Width="60"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 内容区域 -->
        <Frame x:Name="ContentFrame" Grid.Row="1" NavigationUIVisibility="Hidden"/>

        <!-- 底部状态栏 -->
        <StatusBar Grid.Row="2" Background="#E1E1E1">
            <StatusBarItem>
                <TextBlock x:Name="TxtStatus" Text="就绪"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="TxtTime" Text=""/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
