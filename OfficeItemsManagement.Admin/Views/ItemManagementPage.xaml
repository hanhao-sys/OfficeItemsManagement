<Page x:Class="OfficeItemsManagement.Admin.Views.ItemManagementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="物品信息维护">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F5F5F5" Padding="10" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <Button Content="新增物品" Click="BtnAdd_Click" Background="#0078D4" Foreground="White" Width="100"/>
                <Button Content="保存修改" Click="BtnSave_Click" Background="#107C10" Foreground="White" Width="100"/>
                <Button Content="删除物品" Click="BtnDelete_Click" Background="#D83B01" Foreground="White" Width="100"/>
                <Button Content="刷新" Click="BtnRefresh_Click" Width="80"/>
                <TextBox x:Name="TxtSearch" Width="200" Margin="20,0,5,0" VerticalContentAlignment="Center" Height="28"/>
                <Button Content="搜索" Click="BtnSearch_Click" Width="60"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 物品列表 -->
            <DataGrid x:Name="DgItems" Grid.Column="0" AutoGenerateColumns="False"
                      IsReadOnly="True" SelectionChanged="DgItems_SelectionChanged" Margin="0,0,5,0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="编码" Binding="{Binding ItemCode}" Width="70"/>
                    <DataGridTextColumn Header="名称" Binding="{Binding ItemName}" Width="*"/>
                    <DataGridTextColumn Header="库存" Binding="{Binding Quantity}" Width="50"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- 编辑区 -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <Border BorderBrush="#CCC" BorderThickness="1" Padding="15">
                    <StackPanel x:Name="EditPanel" IsEnabled="False">
                        <TextBlock Text="物品信息编辑" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="物品编码:"/>
                            <TextBox x:Name="TxtItemCode" Grid.Column="1" Height="28"/>
                        </Grid>

                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="物品名称:"/>
                            <TextBox x:Name="TxtItemName" Grid.Column="1" Height="28"/>
                        </Grid>

                        <!-- 物品类别 — 单选按钮 -->
                        <GroupBox Header="物品类别" Margin="0,10" Padding="8">
                            <StackPanel>
                                <WrapPanel>
                                    <RadioButton x:Name="RbPaper" Content="纸张" GroupName="Category" Tag="1" Margin="5"/>
                                    <RadioButton x:Name="RbStationery" Content="文具" GroupName="Category" Tag="2" Margin="5"/>
                                    <RadioButton x:Name="RbCutter" Content="刀具" GroupName="Category" Tag="3" Margin="5"/>
                                    <RadioButton x:Name="RbDoc" Content="单据" GroupName="Category" Tag="4" Margin="5"/>
                                    <RadioButton x:Name="RbGift" Content="礼品" GroupName="Category" Tag="5" Margin="5"/>
                                    <RadioButton x:Name="RbOther" Content="其它" GroupName="Category" Tag="6" Margin="5" IsChecked="True"/>
                                </WrapPanel>
                            </StackPanel>
                        </GroupBox>

                        <!-- 产地 — 下拉列表 -->
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="产地:"/>
                            <ComboBox x:Name="CmbOrigin" Grid.Column="1" Height="28"
                                      DisplayMemberPath="Name" SelectedValuePath="Name"/>
                        </Grid>

                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="规格:"/>
                            <TextBox x:Name="TxtSpec" Grid.Column="1" Height="28"/>
                        </Grid>

                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="型号:"/>
                            <TextBox x:Name="TxtModel" Grid.Column="1" Height="28"/>
                        </Grid>

                        <!-- 图片 -->
                        <GroupBox Header="物品图片" Margin="0,10" Padding="8">
                            <StackPanel>
                                <Button Content="选择图片..." Click="BtnSelectImage_Click" Width="100" Margin="0,5"/>
                                <Image x:Name="ImgPreview" Stretch="Uniform" MaxHeight="150" Margin="0,5"/>
                                <TextBlock x:Name="TxtImagePath" Foreground="Gray" FontSize="11"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
