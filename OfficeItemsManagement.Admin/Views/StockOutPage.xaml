<Page x:Class="OfficeItemsManagement.Admin.Views.StockOutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="物品出库（领用审批）">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="领用申请审批" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

        <!-- 操作按钮 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="确认领用" Click="BtnApprove_Click" Background="#107C10" Foreground="White" Width="100" Height="32"/>
            <Button Content="驳回申请" Click="BtnReject_Click" Background="#D83B01" Foreground="White" Width="100" Height="32"/>
            <Button Content="刷新" Click="BtnRefresh_Click" Width="80" Height="32"/>
            <Separator Width="20"/>
            <RadioButton x:Name="RbAll" Content="全部" GroupName="Filter" IsChecked="True" Checked="FilterChanged" Margin="5,0"/>
            <RadioButton x:Name="RbPending" Content="待审批" GroupName="Filter" Checked="FilterChanged" Margin="5,0"/>
            <RadioButton x:Name="RbApproved" Content="已确认" GroupName="Filter" Checked="FilterChanged" Margin="5,0"/>
            <RadioButton x:Name="RbRejected" Content="已驳回" GroupName="Filter" Checked="FilterChanged" Margin="5,0"/>
        </StackPanel>

        <!-- 领用列表 -->
        <DataGrid x:Name="DgStockOut" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="流水号" Binding="{Binding StockOutNo}" Width="130"/>
                <DataGridTextColumn Header="物品编码" Binding="{Binding ItemCode}" Width="80"/>
                <DataGridTextColumn Header="物品名称" Binding="{Binding ItemName}" Width="130"/>
                <DataGridTextColumn Header="数量" Binding="{Binding Quantity}" Width="60"/>
                <DataGridTextColumn Header="领用人" Binding="{Binding ApplicantId}" Width="80"/>
                <DataGridTextColumn Header="领用日期" Binding="{Binding ApplyDate, StringFormat={}{0:yyyy-MM-dd}}" Width="100"/>
                <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="70">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="Black"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="0">
                                    <Setter Property="Foreground" Value="Orange"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="1">
                                    <Setter Property="Foreground" Value="Green"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="2">
                                    <Setter Property="Foreground" Value="Red"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
