<Page x:Class="OfficeItemsManagement.Admin.Views.StockQueryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="库存查询">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="库存查询" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

        <TabControl Grid.Row="1">
            <!-- Tab 1: 库存总览 -->
            <TabItem Header="库存总览">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Label Content="类别筛选:"/>
                        <ComboBox x:Name="CmbCategoryFilter" Width="150" Height="28"
                                  DisplayMemberPath="Name" SelectedValuePath="Id"/>
                        <Button Content="查询" Click="BtnStockQuery_Click" Width="60" Margin="10,0"/>
                        <Button Content="全部" Click="BtnStockQueryAll_Click" Width="60"/>
                        <Button Content="刷新" Click="BtnStockRefresh_Click" Width="60" Margin="10,0"/>
                    </StackPanel>

                    <DataGrid x:Name="DgStock" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="物品编码" Binding="{Binding ItemCode}" Width="90"/>
                            <DataGridTextColumn Header="物品名称" Binding="{Binding ItemName}" Width="*"/>
                            <DataGridTextColumn Header="类别" Binding="{Binding CategoryName}" Width="70"/>
                            <DataGridTextColumn Header="产地" Binding="{Binding Origin}" Width="80"/>
                            <DataGridTextColumn Header="规格" Binding="{Binding Specification}" Width="80"/>
                            <DataGridTextColumn Header="型号" Binding="{Binding Model}" Width="80"/>
                            <DataGridTextColumn Header="库存数量" Binding="{Binding Quantity}" Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Quantity}" Value="0">
                                                <Setter Property="Foreground" Value="Red"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Tab 2: 入库明细 -->
            <TabItem Header="入库明细">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Label Content="物品编码:"/>
                        <TextBox x:Name="TxtInItemCode" Width="120" Height="28" VerticalContentAlignment="Center"/>
                        <Button Content="查询" Click="BtnInDetailQuery_Click" Width="60" Margin="10,0"/>
                        <Button Content="刷新" Click="BtnInDetailRefresh_Click" Width="60"/>
                    </StackPanel>

                    <DataGrid x:Name="DgStockInDetail" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="流水号" Binding="{Binding StockInNo}" Width="130"/>
                            <DataGridTextColumn Header="物品编码" Binding="{Binding ItemCode}" Width="80"/>
                            <DataGridTextColumn Header="物品名称" Binding="{Binding ItemName}" Width="120"/>
                            <DataGridTextColumn Header="购买日期" Binding="{Binding PurchaseDate, StringFormat={}{0:yyyy-MM-dd}}" Width="100"/>
                            <DataGridTextColumn Header="数量" Binding="{Binding Quantity}" Width="60"/>
                            <DataGridTextColumn Header="单价" Binding="{Binding UnitPrice, StringFormat={}{0:F2}}" Width="80"/>
                            <DataGridTextColumn Header="总价" Binding="{Binding TotalPrice, StringFormat={}{0:F2}}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="上一页" Click="BtnInPrev_Click" Width="70"/>
                        <TextBlock x:Name="TxtInPage" VerticalAlignment="Center" Margin="10,0" Text="第 1 页"/>
                        <Button Content="下一页" Click="BtnInNext_Click" Width="70"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Tab 3: 领用明细 -->
            <TabItem Header="领用明细">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Label Content="物品编码:"/>
                        <TextBox x:Name="TxtOutItemCode" Width="120" Height="28" VerticalContentAlignment="Center"/>
                        <Button Content="查询" Click="BtnOutDetailQuery_Click" Width="60" Margin="10,0"/>
                        <Button Content="刷新" Click="BtnOutDetailRefresh_Click" Width="60"/>
                    </StackPanel>

                    <DataGrid x:Name="DgStockOutDetail" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="流水号" Binding="{Binding StockOutNo}" Width="130"/>
                            <DataGridTextColumn Header="物品编码" Binding="{Binding ItemCode}" Width="80"/>
                            <DataGridTextColumn Header="物品名称" Binding="{Binding ItemName}" Width="120"/>
                            <DataGridTextColumn Header="数量" Binding="{Binding Quantity}" Width="60"/>
                            <DataGridTextColumn Header="领用人" Binding="{Binding ApplicantId}" Width="80"/>
                            <DataGridTextColumn Header="领用日期" Binding="{Binding ApplyDate, StringFormat={}{0:yyyy-MM-dd}}" Width="100"/>
                            <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="60"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="上一页" Click="BtnOutPrev_Click" Width="70"/>
                        <TextBlock x:Name="TxtOutPage" VerticalAlignment="Center" Margin="10,0" Text="第 1 页"/>
                        <Button Content="下一页" Click="BtnOutNext_Click" Width="70"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
