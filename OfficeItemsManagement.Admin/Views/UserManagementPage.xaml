<Page x:Class="OfficeItemsManagement.Admin.Views.UserManagementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="用户维护">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 操作区 -->
        <Border Grid.Row="0" Background="#F5F5F5" Padding="10" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <Button Content="新增用户" Click="BtnAdd_Click" Background="#0078D4" Foreground="White" Width="100"/>
                <Button Content="保存修改" Click="BtnSave_Click" Background="#107C10" Foreground="White" Width="100"/>
                <Button Content="删除用户" Click="BtnDelete_Click" Background="#D83B01" Foreground="White" Width="100"/>
                <Button Content="刷新" Click="BtnRefresh_Click" Width="80"/>
            </StackPanel>
        </Border>

        <!-- 数据区 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- 用户列表 -->
            <Border Grid.Column="0" BorderBrush="#CCC" BorderThickness="1" Margin="0,0,5,0">
                <ListBox x:Name="LstUsers" SelectionChanged="LstUsers_SelectionChanged"
                         DisplayMemberPath="UserId" FontSize="14"/>
            </Border>

            <!-- 编辑区 -->
            <Border Grid.Column="1" BorderBrush="#CCC" BorderThickness="1" Padding="15">
                <StackPanel x:Name="EditPanel" IsEnabled="False">
                    <TextBlock Text="用户信息编辑" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label Content="用户ID:"/>
                        <TextBox x:Name="TxtUserId" Grid.Column="1" Height="28"/>
                    </Grid>

                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label Content="密码:"/>
                        <TextBox x:Name="TxtPassword" Grid.Column="1" Height="28"/>
                    </Grid>

                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label Content="姓名:"/>
                        <TextBox x:Name="TxtName" Grid.Column="1" Height="28"/>
                    </Grid>

                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label Content="性别:"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <RadioButton x:Name="RbMale" Content="男" GroupName="Gender" IsChecked="True" Margin="0,0,15,0"/>
                            <RadioButton x:Name="RbFemale" Content="女" GroupName="Gender"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label Content="出生日期:"/>
                        <DatePicker x:Name="DpBirthDate" Grid.Column="1" Height="28"/>
                    </Grid>

                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label Content="联系电话:"/>
                        <TextBox x:Name="TxtPhone" Grid.Column="1" Height="28"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
