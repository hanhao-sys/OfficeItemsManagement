<Page x:Class="OfficeItemsManagement.Admin.Views.StockInPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="物品入库">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 入库表单 -->
        <Border Grid.Row="0" Background="#F0F7FF" BorderBrush="#0078D4" BorderThickness="1" Padding="15" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="物品入库" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>
                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="物品编码:"/>
                    <Grid Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtItemCode" Grid.Column="0" Height="28" VerticalContentAlignment="Center"/>
                        <Button Grid.Column="1" Content="..." Width="30" Height="28" Click="BtnSelectItem_Click"
                                ToolTip="选择物品"/>
                    </Grid>
                </Grid>

                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="物品名称:"/>
                    <TextBox x:Name="TxtItemName" Grid.Column="1" Height="28" IsReadOnly="True" Background="#F0F0F0"/>
                </Grid>

                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="当前库存:"/>
                    <TextBox x:Name="TxtCurrentQty" Grid.Column="1" Height="28" IsReadOnly="True" Background="#F0F0F0"/>
                </Grid>

                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="购买日期:"/>
                    <DatePicker x:Name="DpPurchaseDate" Grid.Column="1" Height="28" SelectedDate="{x:Static system:DateTime.Now}"
                                xmlns:system="clr-namespace:System;assembly=System.Runtime"/>
                </Grid>

                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="购买数量:"/>
                    <TextBox x:Name="TxtQuantity" Grid.Column="1" Width="120" Height="28"
                             TextChanged="TxtQuantity_TextChanged" VerticalContentAlignment="Center"/>
                    <Label Grid.Column="2" Content="（必须 > 0）" Foreground="Gray" FontSize="11"/>
                </Grid>

                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="单价:"/>
                    <TextBox x:Name="TxtUnitPrice" Grid.Column="1" Width="120" Height="28"
                             TextChanged="TxtUnitPrice_TextChanged" VerticalContentAlignment="Center"/>
                    <Label Grid.Column="2" Content="元" Foreground="Gray" FontSize="11"/>
                </Grid>

                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="总价:" FontWeight="Bold"/>
                    <TextBox x:Name="TxtTotalPrice" Grid.Column="1" Width="120" Height="28"
                             IsReadOnly="True" Background="#FFFFCC" FontWeight="Bold" VerticalContentAlignment="Center"/>
                    <Label Grid.Column="2" Content="元（自动计算）" Foreground="Gray" FontSize="11"/>
                </Grid>

                <Button Content="提交入库" Click="BtnSubmit_Click" Background="#0078D4" Foreground="White"
                        Width="120" Height="35" Margin="0,12,0,0" FontWeight="Bold"/>
            </StackPanel>
        </Border>

        <!-- 入库记录标题 -->
        <TextBlock Grid.Row="1" Text="入库记录" FontSize="16" FontWeight="Bold" Margin="0,10,0,5"/>

        <!-- 入库记录列表（最新50条，避免百万数据卡顿） -->
        <DataGrid x:Name="DgStockIn" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="流水号" Binding="{Binding StockInNo}" Width="130"/>
                <DataGridTextColumn Header="物品编码" Binding="{Binding ItemCode}" Width="80"/>
                <DataGridTextColumn Header="物品名称" Binding="{Binding Item.ItemName}" Width="120"/>
                <DataGridTextColumn Header="购买日期" Binding="{Binding PurchaseDate, StringFormat={}{0:yyyy-MM-dd}}" Width="100"/>
                <DataGridTextColumn Header="数量" Binding="{Binding Quantity}" Width="60"/>
                <DataGridTextColumn Header="单价" Binding="{Binding UnitPrice, StringFormat={}{0:F2}}" Width="80"/>
                <DataGridTextColumn Header="总价" Binding="{Binding TotalPrice, StringFormat={}{0:F2}}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
