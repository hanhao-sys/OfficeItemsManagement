<Window x:Class="OfficeItemsManagement.Admin.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="办公物品管理系统 - 管理员登录" Height="320" Width="420"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="管理员登录" FontSize="22" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <Grid Grid.Row="1" Margin="0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Content="用户名:" Grid.Column="0"/>
            <TextBox x:Name="TxtUserId" Grid.Column="1" Height="28" VerticalContentAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="2" Margin="0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Content="密码:" Grid.Column="0"/>
            <PasswordBox x:Name="TxtPassword" Grid.Column="1" Height="28" VerticalContentAlignment="Center"/>
        </Grid>

        <TextBlock x:Name="TxtError" Grid.Row="3" Foreground="Red" HorizontalAlignment="Center"
                   Visibility="Collapsed" Margin="0,8"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15">
            <Button Content="登录" Width="100" Height="35" Click="BtnLogin_Click"
                    Background="#0078D4" Foreground="White" FontWeight="Bold"/>
            <Button Content="取消" Width="100" Height="35" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
